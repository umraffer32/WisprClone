# One correction per line: wrong=right (whole-word, case-insensitive match).
# Edits apply to the next dictation, no restart needed.

# Copy this file to corrections.txt and fill it in with your own
# mishearings, names, and project vocabulary. corrections.txt is
# gitignored on purpose - it fills up with things specific to you.
github=GitHub
there going=they're going

# a spoken "<name> MD" is the file <NAME>.md; one line per file rather than a
# general rule, since "AMD" is a word too
ClaudeMD=CLAUDE.md
readme MD=README.md
setup MD=SETUP.md
